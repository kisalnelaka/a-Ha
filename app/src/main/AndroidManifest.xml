<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Launcher application indexing -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Android 13+ runtime notification dispatch -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AudioTrack ambient noise generation and audio routing -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Direct on-device BYOK AI endpoints (Groq/OpenRouter/Gemini, 0 telemetry) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Tactile haptic feedback for executive function pacing -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Setting dopamine-neutral dark wallpapers -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Calendar glance: next upcoming event within 24h -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- UsageStatsManager for last-opened app context (special app op, granted via Settings) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Custom wallpaper photo picker (Android 12 and below) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />


    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AHa"
        tools:targetApi="33">

        <!-- Primary Launcher Activity -->
        <activity
            android:name=".presentation.MainActivity"
            android:clearTaskOnLaunch="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mindful Launch Friction Gate -->
        <activity
            android:name=".presentation.friction.MindfulDelayActivity"
            android:exported="false"
            android:theme="@style/Theme.AHa" />

        <!-- Landscape Charging StandBy Screensaver -->
        <service
            android:name=".presentation.desk.DeskModeDreamService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/desk_mode_dream" />
        </service>

    </application>


</manifest>
